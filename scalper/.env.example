# Stejne nazvy jako GitHub Actions secrets v MarketTrace.
ALPACA_KEY=
ALPACA_SECRET=

# Nastaveni tohoto projektu.
APCA_DATA_FEED=iex
PORT=4310

# Bezpecne vychozi nastaveni
WATCHLIST=SPY,QQQ
AUTO_EXECUTE=false
RISK_PER_TRADE_PCT=0.10
MAX_DAILY_LOSS_PCT=0.75
MAX_TRADES_PER_DAY=6
MAX_SPREAD_BPS=8
STOP_ATR_MULTIPLIER=1.0
TARGET_R_MULTIPLIER=1.5
COOLDOWN_MINUTES=10
